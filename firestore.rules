rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate stream config
    function isValidStream(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.url is string && data.url.size() <= 500 &&
             data.createdAt is timestamp;
    }

    match /public_content/{document=**} {
      allow read: if true;
    }

    match /broadcast_streams/{streamId} {
      // Admins can read, create, update, delete
      allow read, write: if request.auth != null && request.auth.token.email == 'admin@example.com';
      
      // Enforce the 1000 limit in create
      allow create: if request.auth != null && request.auth.token.email == 'admin@example.com' &&
                      getAfter(/databases/$(database)/documents/broadcast_streams).data.size() <= 1000;
    }
  }
}
